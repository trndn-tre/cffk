{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cffk",
  "compatibility_date": "2026-03-12",
  "main": "vike:server-entry",
  // "send_email": [ { "name": "EMAIL" } ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "cffk-db",
      "database_id": "41c19eac-b68c-4031-92e3-a8f49251eb12",
      "migrations_dir": "database/migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },
  "vars": {
    "ADMIN_PATH": "admin-9527",
    "BETTER_AUTH_URL": "https://cffk.a3129877588.workers.dev"
  }
}
