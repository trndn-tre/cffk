{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cffk",
  "compatibility_date": "2026-03-12",
  "main": "vike:server-entry",
  // "send_email": [ { "name": "EMAIL" } ], // <-- 已注释，如果你确实需要邮件功能，请参考第4点
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cffk_db",
      "database_id": "414126b3-f47e-4b7f-a649-efbb62394b53",
      "migrations_dir": "database/migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0
  },
  "vars": {
    "ADMIN_PATH": "admin-9527",
    "BETTER_AUTH_URL": "https://cffk.a3129877588.workers.dev"
  }
}

